<Window x:Class="SyncSAW.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:core="clr-namespace:SyncSAW.Core;assembly=SyncSAW.Core"
        xmlns:local="clr-namespace:SyncSAW.App"
        mc:Ignorable="d"
        Title="SAW Synchronization"
        Height="780"
        Width="1180"
        MinHeight="640"
        MinWidth="920"
        Icon="Assets/SyncSAW.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:SyncStateDisplayConverter x:Key="SyncStateDisplayConverter"/>
        <local:FileSizeConverter x:Key="FileSizeConverter"/>

        <Style x:Key="SummaryIconStyle" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}"/>
        </Style>

        <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder"
                                Margin="1"
                                Background="Transparent"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:SyncItemState.InSync}">
                    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:SyncItemState.Pending}">
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:SyncItemState.Error}">
                    <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:SyncItemState.InSync}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:SyncItemState.Pending}">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:SyncItemState.Error}">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SawBadgeBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SyncedToSaw}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SawBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="Not yet"/>
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SyncedToSaw}" Value="True">
                    <Setter Property="Text" Value="Yes"/>
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid Margin="24,18,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="44"
                            Height="44"
                            Margin="0,0,12,0"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="11">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons, Segoe UI Symbol"
                                   FontSize="24"
                                   Foreground="{DynamicResource OnAccentBrush}"
                                   Text=""/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="23"
                                   FontWeight="SemiBold"
                                   Text="SAW Synchronization"/>
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12"
                                   Text="Secure synchronization with SAW"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Height="30"
                            Margin="0,0,8,0"
                            Padding="9,0"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="15">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ConnectionStatusDot"
                                     Width="7"
                                     Height="7"
                                     Margin="0,0,7,0"
                                     Fill="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="ConnectionStatusTextBlock"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="Not signed in"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="SignInButton"
                            Margin="0,0,8,0"
                            Click="SignIn_Click"
                            Content="Sign in"/>
                    <Button x:Name="CancelButton"
                            Margin="0,0,8,0"
                            Style="{StaticResource DangerButton}"
                            Click="CancelOperation_Click"
                            Visibility="Collapsed"
                            Content="Cancel"/>
                    <Button Margin="0,0,8,0"
                            Style="{StaticResource IconButton}"
                            Click="Refresh_Click"
                            ToolTip="Refresh files and synchronization plan"
                            Content=""/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Click="SyncNow_Click"
                            Content="↻  Sync now"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,10,0"
                        Padding="14"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="SyncStatusIconBorder"
                                Style="{StaticResource SummaryIconStyle}"
                                Background="{DynamicResource SuccessBackgroundBrush}">
                            <TextBlock x:Name="SyncStatusIconTextBlock"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons, Segoe UI Symbol"
                                       FontSize="19"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       Text="&#xE73E;"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       Text="SYNCHRONIZATION STATUS"/>
                            <TextBlock x:Name="SyncStatusTitleTextBlock"
                                       Margin="0,3,0,0"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="Ready to configure"/>
                            <TextBlock x:Name="SyncStatusDetailTextBlock"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Text="Choose a local folder and Blob container"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Margin="0,0,10,0"
                        Padding="14"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SummaryIconStyle}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="21"
                                       Foreground="{DynamicResource InfoBrush}"
                                       Text="⇄"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       Text="SYNC MODE"/>
                            <TextBlock x:Name="ModeSummaryTextBlock"
                                       Margin="0,3,0,0"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="Synchronize"/>
                            <TextBlock x:Name="ModeDetailTextBlock"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       Text="Upload local · Download cloud-only"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Padding="14"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SummaryIconStyle}"
                                Background="{DynamicResource CardSecondaryBrush}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons, Segoe UI Symbol"
                                       FontSize="19"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="&#xE823;"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       Text="SYNC INTERVAL"/>
                            <ComboBox x:Name="AutoSyncIntervalComboBox"
                                      Width="120"
                                      Height="28"
                                      Margin="0,3,0,0"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="SettingsChanged"
                                      ToolTip="Automatic synchronization interval">
                                <ComboBoxItem Tag="5" Content="Every 5 seconds"/>
                                <ComboBoxItem Tag="10" Content="Every 10 seconds"/>
                                <ComboBoxItem Tag="30" Content="Every 30 seconds"/>
                                <ComboBoxItem Tag="60" Content="Every 1 minute"/>
                            </ComboBox>
                            <TextBlock x:Name="AutoSyncDetailTextBlock"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       Text="Jobs never overlap"/>
                        </StackPanel>
                        <CheckBox x:Name="PauseSyncCheckBox"
                                  Grid.Column="2"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Pause automatic synchronization"
                                  ToolTip="Pause automatic synchronization"
                                  Checked="SettingsChanged"
                                  Unchecked="SettingsChanged"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Margin="0,0,0,12"
                    Padding="15,13"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="Sync configuration"/>
                        <TextBlock Margin="130,1,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11"
                                   Text="Changes are saved automatically"/>
                        <Button HorizontalAlignment="Right"
                                Height="28"
                                Padding="9,0"
                                Style="{StaticResource SubtleButton}"
                                Click="OpenAdvancedSettings_Click"
                                Foreground="{DynamicResource AccentBrush}"
                                Content="⚙  Advanced settings"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,11,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Margin="2,0,0,5"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Text="Local folder"/>
                            <Grid>
                                <TextBox x:Name="LocalFolderTextBox"
                                         Padding="10,0,38,0"
                                         TextChanged="SettingsChanged"/>
                                <Button Width="30"
                                        Height="28"
                                        Margin="0,0,3,0"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource IconButton}"
                                        Click="BrowseFolder_Click"
                                        ToolTip="Browse for a local folder"
                                        Content="&#xE838;"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="2,0,0,5"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Text="Storage account"/>
                            <TextBox x:Name="StorageAccountTextBox"
                                     CharacterCasing="Lower"
                                     TextChanged="SettingsChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Margin="2,0,0,5"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Text="Blob container"/>
                            <TextBox x:Name="ContainerTextBox"
                                     CharacterCasing="Lower"
                                     TextChanged="SettingsChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Margin="2,0,0,5"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Text="Mode"/>
                            <Border Height="34"
                                    Padding="1"
                                    Background="{DynamicResource CardSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="SyncModeRadio"
                                                 Grid.Column="0"
                                                 GroupName="SyncMode"
                                                 Style="{StaticResource SegmentButtonStyle}"
                                                 Checked="SettingsChanged"
                                                 Content="⇄  Sync"/>
                                    <RadioButton x:Name="DeletionModeRadio"
                                                 Grid.Column="1"
                                                 GroupName="SyncMode"
                                                 Style="{StaticResource SegmentButtonStyle}"
                                                 Checked="DeletionMode_Checked"
                                                 Content="✕  Deletion"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Style="{StaticResource CardStyle}"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="31"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="15,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="Files and planned actions"/>
                            <Border Margin="8,0,0,0"
                                    Padding="7,2"
                                    Background="{DynamicResource CardSecondaryBrush}"
                                    CornerRadius="10">
                                <TextBlock x:Name="FileCountTextBlock"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="10"
                                           Text="0 files"/>
                            </Border>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Margin="0,0,2,0"
                                    Height="30"
                                    Padding="9,0"
                                    Style="{StaticResource SubtleButton}"
                                    Click="UploadFile_Click"
                                    Content="↑  Upload"/>
                            <Button x:Name="DownloadRemoteButton"
                                    Margin="0,0,6,0"
                                    Height="30"
                                    Padding="11,0"
                                    Click="DownloadFile_Click"
                                    Content="↓  Download"/>
                            <Button x:Name="OpenRemoteButton"
                                    Margin="0,0,6,0"
                                    Height="30"
                                    Padding="11,0"
                                    Click="OpenRemote_Click"
                                    Content="↗  Open file"/>
                            <Button x:Name="DeleteRemoteButton"
                                    Height="30"
                                    MinWidth="112"
                                    Padding="11,0"
                                    Style="{StaticResource DangerPrimaryButton}"
                                    Click="DeleteRemote_Click"
                                    Content="Delete selected"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="FilesDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionChanged="FilesDataGrid_SelectionChanged"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="54" Header="Select">
                               <DataGridTemplateColumn.CellTemplate>
                                   <DataTemplate>
                                       <CheckBox HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 IsChecked="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected, Mode=OneWay}"
                                                 PreviewMouseLeftButtonDown="FileSelectionCheckBox_PreviewMouseLeftButtonDown"
                                                 ToolTip="Add or remove this file from the batch selection"/>
                                   </DataTemplate>
                               </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="2.2*" MinWidth="190" Header="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Margin="0,0,9,0"
                                                       FontFamily="Segoe Fluent Icons, Segoe UI Symbol"
                                                       FontSize="15"
                                                       Foreground="{DynamicResource InfoBrush}"
                                                       Text="&#xE7C3;"/>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Path}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="125" Header="State">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                            <TextBlock Style="{StaticResource StatusBadgeTextStyle}"
                                                       Text="{Binding State, Converter={StaticResource SyncStateDisplayConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="165"
                                                Header="Last modified"
                                                Binding="{Binding LastModified, StringFormat={}{0:MMM d, yyyy h:mm tt}}"/>
                            <DataGridTemplateColumn Width="100" Header="Size">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="{DynamicResource MutedBrush}"
                                                   Text="{Binding Size, Converter={StaticResource FileSizeConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="145" Header="Action">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Action}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="110" Header="Synced to SAW">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SawBadgeBorderStyle}">
                                            <TextBlock Style="{StaticResource SawBadgeTextStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="1.4*" MinWidth="120" Header="Error" Binding="{Binding Error}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2"
                          Background="{DynamicResource CardSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Margin="13,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,8,0"
                                     Fill="{DynamicResource SuccessBrush}"/>
                            <TextBlock x:Name="StatusTextBlock"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Text="Ready. Configure a local folder and Azure Blob container."/>
                        </StackPanel>
                        <TextBlock x:Name="DeleteStatusTextBlock"
                                   Grid.Column="1"
                                   Margin="0,0,13,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11"
                                   Text="Destination deletion is off"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Height="4" Margin="0,8,0,0">
                <ProgressBar x:Name="BusyProgressBar"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <Grid x:Name="AdvancedSettingsOverlay"
              Panel.ZIndex="20"
              Background="{DynamicResource OverlayScrimBrush}"
              MouseLeftButtonDown="AdvancedSettingsOverlay_MouseLeftButtonDown"
              Visibility="Collapsed">
            <Border Width="430"
                    Margin="16"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource CardStyle}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28"
                                      Direction="180"
                                      Opacity="0.25"
                                      ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="18,0,10,0">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="Advanced settings"/>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource IconButton}"
                                Click="CloseAdvancedSettings_Click"
                                ToolTip="Close settings"
                                Content=""/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Padding="18,0,18,16"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,10"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Text="Authentication, appearance, and executable discovery"/>

                            <TextBlock Margin="2,8,0,5"
                                       FontWeight="SemiBold"
                                       Text="Theme"/>
                            <ComboBox x:Name="ThemeComboBox"
                                      SelectionChanged="ThemeChanged">
                                <ComboBoxItem Tag="System" Content="Use Windows setting"/>
                                <ComboBoxItem Tag="Light" Content="Light"/>
                                <ComboBoxItem Tag="Dark" Content="Dark"/>
                            </ComboBox>

                            <Separator Margin="0,18,0,13"
                                       Background="{DynamicResource BorderBrush}"/>

                            <TextBlock Margin="2,0,0,5"
                                       FontWeight="SemiBold"
                                       Text="Microsoft Entra authentication"/>
                            <ComboBox x:Name="LoginModeComboBox"
                                      SelectionChanged="SettingsChanged">
                                <ComboBoxItem Tag="AzureCli" Content="Azure CLI / Windows broker (Conditional Access)"/>
                                <ComboBoxItem Tag="DeviceCode" Content="AzCopy device code (may be blocked by policy)"/>
                            </ComboBox>

                            <TextBlock Margin="2,13,0,5"
                                       FontWeight="SemiBold"
                                       Text="Microsoft Entra tenant ID"/>
                            <TextBox x:Name="TenantIdTextBox"
                                     TextChanged="SettingsChanged"/>

                            <TextBlock Margin="2,13,0,5"
                                       FontWeight="SemiBold"
                                       Text="Azure subscription ID"/>
                            <TextBox x:Name="SubscriptionIdTextBox"
                                     TextChanged="SettingsChanged"/>
                            <TextBlock Margin="2,4,0,0"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="Clear to keep Azure CLI's current subscription selection."/>

                            <TextBlock Margin="2,13,0,5"
                                       FontWeight="SemiBold"
                                       Text="Azure CLI path"/>
                            <TextBox x:Name="AzureCliPathTextBox"
                                     TextChanged="SettingsChanged"/>
                            <TextBlock Margin="2,4,0,0"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="Optional. PATH and standard install locations are searched."/>

                            <TextBlock Margin="2,13,0,5"
                                       FontWeight="SemiBold"
                                       Text="AzCopy path"/>
                            <TextBox x:Name="AzCopyPathTextBox"
                                     TextChanged="SettingsChanged"/>
                            <TextBlock Margin="2,4,0,0"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="Optional. PATH and AZCOPY_PATH are also searched."/>
                            <TextBlock x:Name="OperationLogLocationTextBlock"
                                       Margin="2,4,0,0"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="Operation logs: application folder"/>

                            <Separator Margin="0,18,0,13"
                                       Background="{DynamicResource BorderBrush}"/>

                            <CheckBox x:Name="MinimizeToTrayCheckBox"
                                      Margin="2,0,0,0"
                                      Checked="SettingsChanged"
                                      Unchecked="SettingsChanged"
                                      Content="Keep running in the notification area"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Padding="10"
                            Background="{DynamicResource CardSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource PrimaryButton}"
                                Click="CloseAdvancedSettings_Click"
                                Content="Done"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
